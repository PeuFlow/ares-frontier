# Application: Neon pooled connection. Replace these demonstration values locally.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
# Migrations: optional direct connection. Falls back to DATABASE_URL when empty.
DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
